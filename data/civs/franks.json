    "buildOrders": [
      {
        "title": "Fast Castle → 4 Scouts + Scorpions (+ Monks)",
        "detail": "Accelerated FC (~20–22 vills) → Stable + Blacksmith → 4 Scouts + Scorpions + Monks. Cavaliers/Knights are the natural follow-up.",
        "map": "resource-rich",
        "source": "kiritastrich",
        "sourceUrl": "https://t.me/kiritastrich/1451"
      }
    ],
    "buildNote": "Scouts are slightly weaker than Turks' baseline, but the free cavalry HP (bloodlines-style) adds weight for push strats, faster berries smooth the FC, and you skip farm-size upgrades. Decent Scorpions; the cost is trash Monks (good only for converting answer-knights).",
    "recommendations": [
      "Use the cavalry HP bonus to win scout/knight fights and push with confidence.",
      "Transition into Knights/Cavaliers — your stable is the strongest part of the tree.",
      "Don't invest in Monks beyond emergency knight conversions."
    ],
    "strengths": [
      "Cavalry +20% HP from Feudal; auto Bloodlines",
