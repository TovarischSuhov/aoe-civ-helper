  "strategy": {
    "sources": [
      "kiritastrich"
    ],
    "buildOrders": [
      {
        "title": "Fast Castle → 4 Scouts + Scorpions (+ Monks)",
        "detail": "Accelerated FC (~20–22 vills) → 4 Scouts + Scorpions + Monks. The hunter bonus makes deer/boar maps especially fast.",
        "map": "resource-rich, deer-heavy",
        "source": "kiritastrich",
        "sourceUrl": "https://t.me/kiritastrich/1451"
      }
    ],
    "buildNote": "A strong analog to Franks; the cavalry HP kicks in from Castle Age, Scorpions are fine, and Monks are a bit stronger than Franks/Celts. The hunter bonus can make the FC noticeably earlier.",
    "recommendations": [
      "Use the hunter bonus to hit a faster up-time on deer/boar maps.",
      "Pair the scout/scorpion spike with Mangudai or Light Cav in late Castle/Imperial.",
      "Mobile siege repositions quickly thanks to the siege movement bonus."
    ],
    "strengths": [
      "Hunters +40% → very fast FC on animal-heavy maps",
      "Cavalry-archer fire-rate bonus (Mangudai)",
      "Faster siege movement"
    ],
    "weaknesses": [
      "No economy bonus on closed/resource-poor maps",
      "Thin infantry late game",
      "No Bombard Cannon"
    ],
    "timings": [
      {
        "label": "Fast Castle",
        "detail": "Earlier up-time off the hunter (+40%) bonus; the source channel hit a no-idle 17+2 — click Castle at ~18 pop — as a benchmark.",
        "source": "kiritastrich"
      }
    ]
  },
