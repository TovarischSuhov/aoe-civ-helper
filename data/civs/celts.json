  "strategy": {
    "sources": [
      "kiritastrich"
    ],
    "buildOrders": [
      {
        "title": "Fast Castle → 4 Scouts + Scorpions (+ Monks)",
        "detail": "Same accelerated FC frame as Turks (~20–22 vills → Stable + Blacksmith → 4 Scouts + Scorpions + Monks). On resource-rich maps.",
        "map": "resource-rich (boar/sheep/deer)",
        "source": "kiritastrich",
        "sourceUrl": "https://t.me/kiritastrich/1451"
      }
    ],
    "buildNote": "Like Burmese with auto woodcutting — you barely feel the missing barding/saddle, because the woodcutting bonus funds the siege mass. Strongest siege in the game for this comp; the cost is weak Monks.",
    "recommendations": [
      "Lean on Scorpions — your siege fires faster and the woodcutting bonus pays for the mass.",
      "Keep Monks minimal (weak monastery); use them only for spot-heals/conversions.",
      "Mobile infantry + fast siege lets you reposition before the opponent stabilizes."
    ],
    "strengths": [
      "Woodcutting bonus → cheap siege mass",
      "Siege fires +20% faster (strongest Scorpions)",
      "Faster-moving infantry"
    ],
    "weaknesses": [
      "Weak Monks (no Redemption/Heresy/etc. options as strong)",
      "Limited gunpowder / no Bombard Cannon",
      "Mediocre archer line"
    ],
    "timings": [
      {
        "label": "Fast Castle",
        "detail": "Click Castle ~20–22 vills → siege workshop fast via wood bonus",
        "source": "kiritastrich"
      }
    ]
  },
