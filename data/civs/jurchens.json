    "buildOrders": [
      {
        "title": "Fast Castle → 4 Scouts + Scorpions (+ Monks)",
        "detail": "Accelerated FC (~20–22 vills) → 4 Scouts + Scorpions + Monks. Hunted/livestock food doesn't decay, so you bank more food for the age-up and unit spam.",
        "map": "resource-rich, hunted/livestock",
        "source": "kiritastrich",
        "sourceUrl": "https://t.me/kiritastrich/1451"
      }
    ],
    "buildNote": "The no-decay food bonus gives a real resource edge, and +25% attack speed on mounted units makes the scouts hit harder. Main weakness: Monks.",
    "recommendations": [
      "Bank the no-decay food into a faster age-up and a bigger scout/scorpion mass.",
      "Use the mounted-unit attack-speed bonus on scouts and (later) cavalry archers/fire lancers.",
      "Cheap/fast siege & fortification upgrades (Castle Age Siege Engineers) help the push."
    ],
    "strengths": [
      "Food doesn't decay (hunted/livestock) → more banked food",
      "Mounted units +25% attack speed",
      "Siege/fort upgrades cheap & fast; Castle-Age Siege Engineers"
    ],
    "weaknesses": [
      "Weak Monks",
      "Reliant on hunting/livestock for the food edge"
